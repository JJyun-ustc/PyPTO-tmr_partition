+        y[o] = skip_bias[o] + out_bias[o];
+        for (int j = 0; j < 12; ++j)
+            y[o] += skip_weight[o][j] * x[j];
+        for (int d = 0; d < 4; ++d)
+            y[o] += out_weight[o][d] * z[d];
+        y[o] = y[o] * residual_std[o] + residual_mean[o];
+    }
+}
