+    double q[4]{}, k[3][4]{}, v[3][4]{}, logits[3]{}, z[4]{};
+    for (int d = 0; d < 4; ++d) {
+        q[d] = q_bias[d];
+        for (int j = 0; j < 12; ++j)
+            q[d] += q_weight[d][j] * x[j];
+        for (int a = 0; a < 3; ++a) {
+            k[a][d] = k_bias[d];
+            v[a][d] = v_bias[d];
+            for (int j = 0; j < 5; ++j) {
+                k[a][d] += k_weight[d][j] * tokens[a][j];
+                v[a][d] += v_weight[d][j] * tokens[a][j];
+            }
+            logits[a] += q[d] * k[a][d] / 2;
+        }
+    }
+    double top = logits[0];
+    for (int a = 1; a < 3; ++a)
+        if (logits[a] > top) top = logits[a];
+    double sum = 0;
+    for (int a = 0; a < 3; ++a) {
+        logits[a] = std::exp(logits[a] - top);
+        sum += logits[a];
+    }
